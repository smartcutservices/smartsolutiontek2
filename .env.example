# Browser Auth is restricted to the dedicated local Emulator project.
# The client refuses any other project, remote host, protocol, or port.
# Never replace these values with the shared SmartCut project before the P0 audit.
NEXT_PUBLIC_FIREBASE_AUTH_PROJECT_ID=demo-smartsolutiontek
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Optional; set only after the public domain/origin is approved.
PUBLIC_SITE_ORIGIN=
